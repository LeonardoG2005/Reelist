      div.nav-actions
        //- Toggle de tema con runas: Ingwaz = modo oscuro, Sowilo = modo claro.
        //- La runa estatica visible la decide el CSS segun html.dark (sin parpadeo al cargar);
        //- la animacion es un sprite (ver scripts/build-rune-sprites.py) controlado por JS.
        button#themeToggle.rune-toggle(
          type="button"
          aria-label="Toggle color theme"
          data-sprite-to-light="/assets/runes/rune-ingwaz-to-sowilo.webp"
          data-sprite-to-dark="/assets/runes/rune-sowilo-to-ingwaz.webp"
          data-frames="30"
          data-duration="3000"
        )
          span.rune-stage(aria-hidden="true")
            img.rune-static.rune-static-ingwaz(src="/assets/runes/rune-ingwaz.png", alt="", draggable="false", decoding="async")
            img.rune-static.rune-static-sowilo(src="/assets/runes/rune-sowilo.png", alt="", draggable="false", decoding="async")
            span.rune-anim
        if userid
          a(type="button", href="/account", class="account")
            if avatarUrl
              img(src=avatarUrl, alt="Your profile", class="account-avatar-img")
            else
              svg.icon.icon-tabler.icons-tabler-outline.icon-tabler-user(
                xmlns="http://www.w3.org/2000/svg"
