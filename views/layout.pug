    script.
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('themeToggle');
        if (!btn) return;
        var anim = btn.querySelector('.rune-anim');
        var FRAMES = parseInt(btn.getAttribute('data-frames'), 10) || 30;
        var DURATION = parseInt(btn.getAttribute('data-duration'), 10) || 3000;
        var FADE_IN = 120;   // ms: la animacion aparece sobre la runa estatica
        var FADE_OUT = 200;  // ms: la animacion se disuelve sobre la nueva runa estatica
        var SPRITES = {
          light: btn.getAttribute('data-sprite-to-light'), // Ingwaz -> Sowilo
          dark: btn.getAttribute('data-sprite-to-dark')    // Sowilo -> Ingwaz
        };
        var reduceMotion = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : { matches: false };
        var canAnimate = typeof anim.animate === 'function';
        var busy = false;
        var run = 0;
        var playing = null;
        var cache = {};

        function isDark() { return root.classList.contains('dark'); }

        function updateLabel() {
          var label = isDark() ? 'Switch to light mode' : 'Switch to dark mode';
          btn.setAttribute('aria-label', label);
          btn.title = label;
        }

        // Precarga + decodificacion del sprite: la promesa se reutiliza (el primer clic no espera si ya cargo)
        function loadSprite(target) {
          if (!cache[target]) {
            cache[target] = new Promise(function (resolve, reject) {
              var img = new Image();
              img.onload = function () {
                if (img.decode) img.decode().then(resolve, resolve); else resolve();
              };
              img.onerror = function () { delete cache[target]; reject(new Error('sprite')); };
              img.src = SPRITES[target];
            });
          }
          return cache[target];
        }

        function withTimeout(promise, ms) {
          return Promise.race([promise, new Promise(function (_, reject) { setTimeout(reject, ms); })]);
        }

        function applyTheme(target) {
          var dark = target === 'dark';
          root.classList.toggle('dark', dark);
          try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
          updateLabel();
        }

        function reset() {
          if (playing) { try { playing.cancel(); } catch (e) {} playing = null; }
          btn.classList.remove('is-playing', 'is-ending');
          btn.removeAttribute('data-from');
          anim.style.backgroundImage = '';
          anim.style.opacity = '';
          btn.removeAttribute('aria-busy');
          busy = false;
        }

        function play(target, token) {
          anim.style.backgroundImage = 'url("' + SPRITES[target] + '")';
          // Animacion nueva en cada clic: siempre arranca en el frame 0 (reproduccion fiable)
          playing = anim.animate(
            [{ backgroundPosition: '0% 0' }, { backgroundPosition: '100% 0' }],
            { duration: DURATION, easing: 'steps(' + FRAMES + ', jump-none)', fill: 'forwards' }
          );
          btn.classList.add('is-playing');

          // El tema cambia justo a mitad de la animacion. Se mide con el reloj de la propia
          // animacion (currentTime), no con un setTimeout, para que coincida con el frame visible.
          var switched = false;
          var HALF = DURATION / 2;
          function switchTheme() {
            if (switched || token !== run) return;
            switched = true;
            applyTheme(target);
          }
          (function watchMidpoint() {
            if (switched || token !== run || !playing) return;
            if ((playing.currentTime || 0) >= HALF) switchTheme();
            else requestAnimationFrame(watchMidpoint);
          })();

          var done = false;
          function finish() {
            if (done || token !== run) return;
            done = true;
            switchTheme(); // por si requestAnimationFrame no corrio (p. ej. pestana en segundo plano)
            // Nueva runa estatica debajo (identica al ultimo frame) y la animacion se disuelve encima.
            btn.classList.add('is-ending');
            btn.classList.remove('is-playing');
            btn.removeAttribute('data-from');
            setTimeout(function () { if (token === run) reset(); }, FADE_OUT + 30);
          }
          playing.finished.then(finish, function () {});
          // Red de seguridad (p. ej. pestana en segundo plano): nunca queda atascado
          setTimeout(finish, DURATION + 500);
        }

        btn.addEventListener('click', function () {
          if (busy) return; // ignora clics mientras dura la transicion
          var target = isDark() ? 'light' : 'dark';
          if (reduceMotion.matches || !canAnimate) {
            applyTheme(target);
            return;
          }
          busy = true;
          btn.setAttribute('aria-busy', 'true');
          var token = ++run;
          // La runa de partida se mantiene visible hasta que la animacion la cubre
          btn.setAttribute('data-from', target === 'dark' ? 'light' : 'dark');
          withTimeout(loadSprite(target), 2500).then(
            function () { if (token === run) play(target, token); },
            function () { if (token === run) { reset(); applyTheme(target); } } // sin sprite: cambio directo
          );
        });

        // Si el navegador restaura la pagina desde la cache (atras/adelante), sin estados a medias
        window.addEventListener('pageshow', function (e) {
          if (e.persisted) { run++; reset(); updateLabel(); }
        });

        updateLabel();

        // Precarga en reposo para que la primera transicion sea instantanea
        function preload() {
          if (reduceMotion.matches || !canAnimate) return;
          loadSprite('light').catch(function () {});
          loadSprite('dark').catch(function () {});
        }
        if (document.readyState === 'complete') setTimeout(preload, 300);
        else window.addEventListener('load', function () {
          if (window.requestIdleCallback) requestIdleCallback(preload, { timeout: 2000 });
          else setTimeout(preload, 300);
        });
      })();
